    {
      "id": "g513qm_capture_only",
      "title": "G513QM Capture Only / Text",
      "nomodeset": true,
      "auto_installer": false,
      "capture_mode": "full",
      "kernel_extra": "pci=noaer nomodeset noplymouth setuphelfer_g513qm_profile=g513qm_capture_only setuphelfer_capture=1 systemd.unit=rescue.target"
