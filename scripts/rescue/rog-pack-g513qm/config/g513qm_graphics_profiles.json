      "blacklist_amdgpu": false,
      "blacklist_nouveau": true,
      "modprobe_blacklist": "nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm,nouveau",
      "auto_installer": false,
      "capture_mode": "full",
      "kernel_extra": "pci=noaer noplymouth consoleblank=0 setuphelfer_g513qm_profile=g513qm_amd_safe setuphelfer_capture=1"
    },
    {
      "id": "g513qm_nvidia_prop_diag",
      "title": "G513QM NVIDIA Proprietary Diagnostic",
      "nomodeset": false,
      "blacklist_amdgpu": false,
      "auto_installer": false,
      "capture_mode": "full",
      "kernel_extra": "pci=noaer nouveau.modeset=0 modprobe.blacklist=nouveau nvidia-drm.modeset=1 noplymouth setuphelfer_g513qm_profile=g513qm_nvidia_prop_diag setuphelfer_capture=1"
    },
    {
      "id": "g513qm_nouveau_fallback",
      "title": "G513QM Nouveau Fallback Diagnostic",
      "nomodeset": false,
      "blacklist_amdgpu": false,
      "modprobe_blacklist": "nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm",
      "auto_installer": false,
      "capture_mode": "full",
      "kernel_extra": "pci=noaer noplymouth setuphelfer_g513qm_profile=g513qm_nouveau_fallback setuphelfer_capture=1"
    },
    {
      "id": "g513qm_basic_emergency",
