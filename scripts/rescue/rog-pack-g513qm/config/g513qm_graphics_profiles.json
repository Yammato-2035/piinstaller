{
  "schema_version": 1,
  "device_binding": "asus_rog_gabriel",
  "profiles": [
    {
      "id": "g513qm_hybrid_auto",
      "title": "G513QM Rescue Hybrid Auto (AMD display)",
      "default_candidate": true,
      "nomodeset": false,
      "blacklist_amdgpu": false,
      "blacklist_nouveau": false,
      "nvidia_modeset": "allow",
      "auto_installer": false,
      "capture_mode": "full",
      "kernel_extra": "pci=noaer noplymouth consoleblank=0 setuphelfer_g513qm_profile=g513qm_hybrid_auto setuphelfer_capture=1"
    },
    {
      "id": "g513qm_amd_safe",
      "title": "G513QM AMD Safe Display (Installer-Fallback)",
      "default_candidate": false,
      "preferred_installer_fallback": true,
