[Unit]
Description=Setuphelfer Rescue auto discovery (001D7B read-only)
After=setuphelfer-backend.service network-online.target setuphelfer-rescue-tui.service setuphelfer-rescue-auto-msi-evidence.service
Wants=setuphelfer-backend.service
ConditionPathExists=/usr/local/sbin/setuphelfer-rescue-auto-discovery
ConditionPathExists=/usr/local/sbin/setuphelfer-rescue-auto-discovery-start-gate
ConditionPathExists=!/run/setuphelfer-rescue/auto-discovery.done

[Service]
Type=oneshot
TimeoutStartSec=2700
ExecCondition=/usr/local/sbin/setuphelfer-rescue-auto-discovery-start-gate
ExecStart=/usr/local/sbin/setuphelfer-rescue-auto-discovery
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=

[Install]
WantedBy=multi-user.target
