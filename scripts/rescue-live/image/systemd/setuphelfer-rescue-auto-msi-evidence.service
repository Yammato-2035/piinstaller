[Unit]
Description=Setuphelfer Rescue auto MSI RS-011B evidence (MSI compat boot, late gate)
After=setuphelfer-backend.service network-online.target setuphelfer-rescue-tui.service setuphelfer-rescue-boot-observer.service
Wants=setuphelfer-backend.service
ConditionPathExists=/usr/local/sbin/setuphelfer-rescue-auto-msi-evidence
ConditionPathExists=!/run/setuphelfer-rescue/auto-msi-evidence.done

[Service]
Type=oneshot
TimeoutStartSec=900
ExecStart=/usr/local/sbin/setuphelfer-rescue-auto-msi-evidence
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
