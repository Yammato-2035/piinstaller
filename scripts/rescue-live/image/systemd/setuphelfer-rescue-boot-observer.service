[Unit]
Description=Setuphelfer Rescue early boot observer (001D7E)
DefaultDependencies=no
After=local-fs.target setuphelfer-rescue-setup-logs-resolver.service
Before=setuphelfer-rescue-auto-msi-evidence.service
Before=setuphelfer-rescue-auto-discovery.service
Wants=setuphelfer-rescue-setup-logs-resolver.service
ConditionPathExists=/usr/local/sbin/setuphelfer-rescue-boot-observer
# Do not re-fire while the text UI owns tty1 — systemd status lines overwrite whiptail.
ConditionPathExists=!/run/setuphelfer/rescue-tui-active

[Service]
Type=oneshot
TimeoutStartSec=30
EnvironmentFile=-/run/setuphelfer-rescue/environment
ExecStart=/usr/local/sbin/setuphelfer-rescue-boot-observer
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
