#!/bin/bash
# RS-002 + RS-005 + RS-008 + RS-011H + PI-RS-MSI-FIX-001: Boot status TTY + boot-timeline.
set -uo pipefail

RESCUE_ROOT="${SETUPHELFER_RESCUE_ROOT:-/opt/setuphelfer-rescue}"
STATE="/run/setuphelfer-rescue/boot-progress.json"
LOG="/run/setuphelfer-rescue/boot-timeline-writer.log"
TTY_LOG="/run/setuphelfer-rescue/boot-progress-tty.log"
TTY="${SETUPHELFER_BOOT_TTY:-/dev/tty1}"
INTERVAL="${SETUPHELFER_BOOT_STATUS_INTERVAL:-4}"
TIMELINE_PY="${SETUPHELFER_BOOT_TIMELINE_PY:-${RESCUE_ROOT}/backend/core/rescue_boot_timeline.py}"
PY="${SETUPHELFER_RESCUE_PYTHON:-${RESCUE_ROOT}/backend/venv/bin/python3}"
[[ -x "$PY" ]] || PY=python3

COMMON="/usr/local/sbin/setuphelfer-rescue-common.sh"
if [[ -f "$COMMON" ]]; then
  # shellcheck source=/dev/null
  source "$COMMON"
  setuphelfer_rescue_shield_console_early "early_boot_progress" || true
fi

SAFE_TTY=0
if command -v setuphelfer_rescue_safe_ui_active >/dev/null 2>&1; then
  setuphelfer_rescue_safe_ui_active && SAFE_TTY=1
elif grep -Eq 'setuphelfer_safe_ui=1|setuphelfer_msi_compat=1|setuphelfer_msi_profile=1' /proc/cmdline 2>/dev/null; then
  SAFE_TTY=1
fi
if [[ "$SAFE_TTY" -eq 1 ]]; then
  INTERVAL="${SETUPHELFER_BOOT_STATUS_INTERVAL:-8}"
fi

_record_timeline() {
  local phase="$1" status="$2" msg_de="$3" msg_en="${4:-$3}"
  mkdir -p "$(dirname "$LOG")" /run/setuphelfer/evidence/boot 2>/dev/null || true
  if [[ -f "$TIMELINE_PY" ]]; then
    PYTHONPATH="${RESCUE_ROOT}/backend${PYTHONPATH:+:$PYTHONPATH}" \
      "$PY" "$TIMELINE_PY" record --phase "$phase" --status "$status" \
      --message-de "$msg_de" --message-en "$msg_en" >>"$LOG" 2>&1 || true
  else
    echo "missing timeline module: $TIMELINE_PY" >>"$LOG"
  fi
}

_finalize_timeline() {
  if [[ -f "$TIMELINE_PY" ]]; then
    PYTHONPATH="${RESCUE_ROOT}/backend${PYTHONPATH:+:$PYTHONPATH}" \
      "$PY" "$TIMELINE_PY" summary >>"$LOG" 2>&1 || true
  fi
}

steps=(
  "Setuphelfer Rettungssystem wird geladen …"
  "Hardware wird erkannt …"
  "Laufwerke werden geprüft …"
  "Protokollspeicher wird vorbereitet …"
  "Bitte warten Sie. Bitte nicht ausschalten."
  "Netzwerk wird geprüft …"
  "Grafische Oberfläche wird gestartet …"
  "Backend wird geprüft …"
)

phase_map=(
  "rescue_boot_status_visible"
  "hardware_probe_started"
  "disk_probe_started"
  "setup_logs_probe_started"
  "rescue_boot_status_visible"
  "network_probe_started"
  "x11_starting"
  "backend_starting"
)

write_state() {
  local idx="$1"
  local msg="$2"
  mkdir -p "$(dirname "$STATE")"
  python3 - "$idx" "$msg" "$STATE" <<'PY'
import json, sys
from datetime import datetime, timezone
idx, msg, path = sys.argv[1:4]
payload = {
    "schema_version": 1,
    "step_index": int(idx),
    "message": msg,
    "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
open(path, "w", encoding="utf-8").write(json.dumps(payload) + "\n")
PY
}

show_tty() {
  local body="$1"
  local force="${2:-0}"
  printf '%s\n' "$body" >>"$TTY_LOG" 2>/dev/null || true
  if [[ "$SAFE_TTY" -eq 1 ]]; then
    force=0
  fi
  if command -v setuphelfer_rescue_tty1_clear_allowed >/dev/null 2>&1 \
     && ! setuphelfer_rescue_tty1_clear_allowed; then
    return 0
  fi
  if [[ "$force" -ne 1 ]]; then
    return 0
  fi
  if [[ -c "$TTY" ]]; then
    {
      printf '\033[2J\033[H\033[1;32mSetuphelfer Rettungssystem wird geladen …\033[0m\n\n'
      printf '%s\n\n' "$body"
      printf '\033[90mBitte warten Sie. Bitte nicht ausschalten.\033[0m\n'
    } >"$TTY" 2>/dev/null || true
  fi
}

mkdir -p /run/setuphelfer/evidence/boot 2>/dev/null || true
_record_timeline "systemd_started" "ok" "Systemd gestartet" "Systemd started"
_record_timeline "rescue_boot_status_visible" "started" "Startstatus sichtbar" "Boot status visible"

idx=0
while [[ $idx -lt ${#steps[@]} ]]; do
  msg="${steps[$idx]}"
  _record_timeline "${phase_map[$idx]:-rescue_boot_status_visible}" "started" "$msg" "$msg"
  write_state "$idx" "$msg"
  show_tty "$msg" 0
  idx=$((idx + 1))
  sleep "$INTERVAL"
done

if [[ "$SAFE_TTY" -eq 1 ]]; then
  final_msg="Bootvorbereitung abgeschlossen — Textmenü bereit."
else
  final_msg="Bootvorbereitung abgeschlossen — GUI übernimmt."
fi

_record_timeline "rescue_boot_status_visible" "ok" "Bootvorbereitung abgeschlossen" "Boot preparation complete"
write_state "$idx" "$final_msg"
show_tty "$final_msg" 0
_finalize_timeline
