#!/bin/bash
# RS-011M / PI-RS-MSI-AUTO-EVIDENCE-001: Auto MSI RS-011B evidence once per boot.
# Waits for TUI handoff + late gate before collect; optional auto-shutdown for lab runs.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=setuphelfer-rescue-common.sh
source "${SCRIPT_DIR}/setuphelfer-rescue-common.sh"

setuphelfer_rescue_ensure_state_dir

if ! setuphelfer_rescue_should_auto_msi_evidence; then
  exit 0
fi

_marker="${SETUPHELFER_RESCUE_STATE_DIR}/auto-msi-evidence.done"
_running="${SETUPHELFER_RESCUE_STATE_DIR}/auto-msi-evidence.running"
if [[ -f "$_marker" ]]; then
  exit 0
fi
touch "$_running" 2>/dev/null || true
trap 'rm -f "$_running" 2>/dev/null || true' EXIT

_log="${SETUPHELFER_RESCUE_STATE_DIR}/auto-msi-evidence.log"
_late_sec="$(setuphelfer_rescue_msi_lab_late_sec)"
# Physical E2E owns the boot: do not burn ~120s+ on MSI late evidence before SABRENT work.
if setuphelfer_rescue_msi_e2e_auto_active; then
  _late_sec=20
fi
_lab_auto=0
if setuphelfer_rescue_msi_lab_auto_active; then
  _lab_auto=1
fi

{
  echo "=== auto-msi-evidence $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  echo "cmdline=$(tr '\0' ' ' </proc/cmdline 2>/dev/null || true)"
  echo "lab_auto=${_lab_auto} late_sec=${_late_sec}"
} >>"$_log"

_i=0
while [[ "$_i" -lt 45 ]]; do
  if curl -sf --connect-timeout 3 --max-time 8 http://127.0.0.1:8000/api/version >/dev/null 2>&1; then
    break
  fi
  _i=$((_i + 1))
  sleep 2
done

if ! curl -sf --connect-timeout 3 --max-time 8 http://127.0.0.1:8000/api/version >/dev/null 2>&1; then
  echo "WARN: backend not ready — auto MSI evidence skipped" >>"$_log"
  setuphelfer_rescue_write_boot_state "auto_msi_evidence_skipped_backend"
  if [[ "$_lab_auto" -eq 1 ]]; then
    setuphelfer_rescue_auto_shutdown_if_requested "backend_not_ready" || true
  fi
  exit 0
fi

if [[ "$_lab_auto" -eq 1 ]]; then
  echo "Lab auto: waiting for TUI ownership (max 180s) before late gate..." >>"$_log"
  setuphelfer_rescue_wait_for_tui_owned 180 >>"$_log" 2>&1 || echo "WARN: TUI ownership timeout — continuing with journal-only evidence" >>"$_log"
else
  if ! systemctl is-active --quiet setuphelfer-rescue-start-assistant.service 2>/dev/null \
     && ! systemctl is-failed --quiet setuphelfer-rescue-start-assistant.service 2>/dev/null; then
    echo "Starting start-assistant (non-lab boot)..." >>"$_log"
    systemctl start --no-block setuphelfer-rescue-start-assistant.service >>"$_log" 2>&1 || true
  fi
  echo "Waiting for TUI ownership (max 180s)..." >>"$_log"
  if ! setuphelfer_rescue_wait_for_tui_owned 180 >>"$_log" 2>&1; then
    echo "WARN: TUI ownership not reached — continuing with uptime late gate" >>"$_log"
  fi
fi

_min_uptime=$((_late_sec + 30))
echo "Late gate: waiting for uptime >= ${_min_uptime}s ..." >>"$_log"
while true; do
  _up="$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)"
  PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<PY 2>/dev/null || true
from core.rescue_physical_e2e_auto_e2e_state import update_auto_e2e_state, write_heartbeat
update_auto_e2e_state(
    phase="msi_evidence_running",
    status="running",
    last_progress=f"Late-Evidence-Gate: ${_up}/${_min_uptime} s",
)
write_heartbeat(run_id="auto-msi-evidence", phase="msi_evidence_running")
PY
  if [[ "$_up" -ge "$_min_uptime" ]]; then
    echo "Late gate reached at uptime=${_up}s" >>"$_log"
    break
  fi
  sleep 5
done

_late_out=""
if _late_out="$(setuphelfer_rescue_write_late_msi_evidence 2>>"$_log")"; then
  echo "Late evidence: ${_late_out}" >>"$_log"
else
  echo "WARN: late evidence write failed" >>"$_log"
fi

_collect_ok=0
PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<'PY' 2>/dev/null || true
from core.rescue_physical_e2e_auto_e2e_state import update_auto_e2e_state, write_heartbeat
update_auto_e2e_state(phase="msi_evidence_running", status="running", last_progress="Evidence wird gesammelt…")
write_heartbeat(run_id="auto-msi-evidence", phase="msi_evidence_running")
PY
if setuphelfer_rescue_run_msi_rs011b_collect >>"$_log" 2>&1; then
  _collect_ok=1
else
  echo "WARN: auto MSI evidence collect failed" >>"$_log"
fi

_ev_base="$(setuphelfer_rescue_evidence_writable_base 2>/dev/null || echo /run/setuphelfer/esp-rw)"
_eval_out=""
if _eval_out="$(setuphelfer_rescue_evaluate_msi_lab_evidence "${_ev_base}/setuphelfer/evidence/msi-rs011b" "$_lab_auto" 2>>"$_log")"; then
  echo "Lab evaluation: ${_eval_out}" >>"$_log"
  setuphelfer_rescue_mirror_evidence_file \
    "${_ev_base}/setuphelfer/evidence/msi-rs011b/lab-auto-result.json" \
    "setuphelfer/evidence/msi-rs011b/lab-auto-result.json" 2>/dev/null || true
fi

_logs_mount=""
for _pat in /media/*/SETUP_LOGS /run/media/*/SETUP_LOGS /run/setuphelfer/esp-rw; do
  for _c in $_pat; do
    [[ -d "$_c" ]] && _logs_mount="$_c" && break 2
  done
done

if [[ -n "$_logs_mount" ]]; then
  PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<PY >>"$_log" 2>&1 || true
from pathlib import Path
import json
from core.rescue_msi_lab_evidence_eval import evaluate_msi_lab_evidence
from core.rescue_physical_e2e_msi_evidence_complete import write_msi_evidence_complete
from core.rescue_payload_version import rescue_payload_version

logs = Path(${_logs_mount@Q})
ev_dir = logs / "setuphelfer/evidence/msi-rs011b"
session_id = ""
session_path = Path("/run/setuphelfer/current-session.json")
if session_path.is_file():
    session_id = str(json.loads(session_path.read_text(encoding="utf-8")).get("session_id") or "")
eval_result = evaluate_msi_lab_evidence(evidence_dir=ev_dir, lab_auto_unattended=True)
passed = str(eval_result.get("result_status") or "") == "passed"
collect_ok = int(${_collect_ok})
# Completion marker = collection finished (Discovery gate). Lab score stays in lab-auto-result.json.
marker_status = "passed" if (passed or collect_ok) else "failed"
if passed or collect_ok:
    try:
        write_msi_evidence_complete(
            logs,
            status=marker_status,
            session_id=session_id,
            payload_version=rescue_payload_version(),
            late_gate_completed=True,
            tui_owned=bool(eval_result.get("tui_owned")),
            evidence_synced=True,
        )
        print("msi-evidence-complete.json written", marker_status)
    except OSError as exc:
        print("msi-evidence-complete write failed:", exc)
PY
fi

_eval_passed=0
if echo "${_eval_out:-}" | grep -q '"result_status"[[:space:]]*:[[:space:]]*"passed"'; then
  _eval_passed=1
fi

if [[ "$_collect_ok" -eq 1 || "$_eval_passed" -eq 1 ]]; then
  touch "$_marker" 2>/dev/null || true
  setuphelfer_rescue_write_boot_state "auto_msi_evidence_collected"
else
  setuphelfer_rescue_write_boot_state "auto_msi_evidence_failed"
fi

sync 2>/dev/null || true
if [[ "$_lab_auto" -eq 1 ]] && ! setuphelfer_rescue_msi_e2e_auto_active; then
  setuphelfer_rescue_auto_shutdown_if_requested "evidence_complete" || true
fi
exit 0