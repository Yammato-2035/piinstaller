#!/bin/bash
# 001D7E — Early boot observer using canonical SETUP_LOGS / bootstrap fallback.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=setuphelfer-rescue-common.sh
source "${SCRIPT_DIR}/setuphelfer-rescue-common.sh"

setuphelfer_rescue_ensure_state_dir
if [[ -f /run/setuphelfer-rescue/environment ]]; then
  set -a
  # shellcheck disable=SC1091
  source /run/setuphelfer-rescue/environment
  set +a
fi

PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<'PY' 2>/dev/null || true
import json
import os
import shutil
from datetime import datetime, timezone
from pathlib import Path

from core.rescue_discovery_observability import boot_id, redact_text
from core.rescue_setup_logs_resolver import (
    BOOTSTRAP_EVIDENCE,
    CANONICAL_MOUNT,
    evidence_root_from_env,
    load_resolution_state,
    migrate_bootstrap_to_persistent,
    resolve_setup_logs,
    setup_logs_root_from_env,
)


def now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


bid = boot_id()
resolution = load_resolution_state() or resolve_setup_logs(allow_mount=True)
evidence_root = evidence_root_from_env()
setup_logs = setup_logs_root_from_env()
persistent = bool(resolution.get("resolved") and evidence_root and Path(str(evidence_root)).is_dir())

if persistent:
    boot_dir = Path(str(evidence_root)) / "discovery-boot" / bid
    storage_mode = "persistent_setup_logs"
else:
    boot_dir = BOOTSTRAP_EVIDENCE / bid
    storage_mode = "runtime_fallback"

boot_dir.mkdir(parents=True, exist_ok=True)
runtime = Path(os.environ.get("SETUPHELFER_RESCUE_DISCOVERY_DIR", "/run/setuphelfer-rescue/discovery"))
runtime.mkdir(parents=True, exist_ok=True)

try:
    cmdline = Path("/proc/cmdline").read_text(encoding="utf-8").strip()
except OSError:
    cmdline = ""

ctx = {
    "schema": "setuphelfer.rescue.discovery-boot-context.v1",
    "boot_id": bid,
    "called_at": now(),
    "cmdline_redacted": redact_text(cmdline),
    "storage_mode": storage_mode,
}
start = {
    "schema": "setuphelfer.rescue.discovery-observer-start.v1",
    "boot_id": bid,
    "observer_started": True,
    "started_at": now(),
    "storage_mode": storage_mode,
}
hb = {
    "schema": "setuphelfer.rescue.discovery-observer-heartbeat.v1",
    "boot_id": bid,
    "state": "alive",
    "updated_at": now(),
    "storage_mode": storage_mode,
}
resolution_copy = dict(resolution or {})
# Do not export raw host media path names into telemetried blobs beyond local evidence.
resolution_copy["canonical_mountpoint"] = str(CANONICAL_MOUNT)

for name, payload in (
    ("00-boot-context.json", ctx),
    ("00-observer-start.json", start),
    ("observer-heartbeat.json", hb),
    ("setup-logs-resolution.json", resolution_copy),
    ("02-observer-bootstrap.json", {"boot_id": bid, "storage_mode": storage_mode, "recorded_at": now()}),
):
    for root in (boot_dir, runtime):
        path = root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

if persistent:
    migrate_bootstrap_to_persistent(boot_id=bid, evidence_root=Path(str(evidence_root)))

msi_done = Path("/run/setuphelfer-rescue/auto-msi-evidence.done").is_file()
gate_present = any(
    (p / name).is_file()
    for p in (boot_dir, runtime)
    for name in ("00-start-gate.json", "start-gate.json")
)
if msi_done and not gate_present:
    missing = {
        "schema": "setuphelfer.rescue.discovery-start-gate-missing.v1",
        "boot_id": bid,
        "status": "failed_discovery_start_gate_not_invoked",
        "recorded_at": now(),
        "storage_mode": storage_mode,
    }
    for root in (boot_dir, runtime):
        (root / "00-start-gate-missing.json").write_text(
            json.dumps(missing, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
        )
PY

exit 0
