def _read_json(path: Path) -> dict[str, Any] | None:
    try:
        if not path.is_file():
            return None
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except (OSError, json.JSONDecodeError):
        return None


def _payload_version() -> str:
    for cand in (
        Path("/opt/setuphelfer-rescue/config/rescue_payload_version.json"),
        Path("/opt/setuphelfer-rescue/config/version.json"),
    ):
        data = _read_json(cand) or {}
        ver = str(data.get("rescue_payload_version") or data.get("project_version") or "").strip()
        if ver:
            return ver
    return os.environ.get("SETUPHELFER_RESCUE_PAYLOAD_VERSION", "").strip() or "unknown"


def _locale() -> str:
    env = (os.environ.get("SETUPHELFER_RESCUE_LOCALE") or "").strip()
    if env in PHASE_LABELS:
        return env
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8", errors="replace")
    except OSError:
        cmdline = ""
    for token in cmdline.split():
        if token.startswith("setuphelfer_locale="):
            loc = token.split("=", 1)[-1].strip()
            if loc in PHASE_LABELS:
                return loc
            if loc.startswith("de"):
                return "de-DE"
            if loc.startswith("fr"):
                return "fr-FR"
            if loc.startswith("nl"):
                return "nl-NL"
            if loc.startswith("en"):
                return "en-US"
    return "de-DE"


def build_health(document_root: Path, *, index_name: str) -> dict[str, Any]:
    index_path = document_root / index_name
    locales_dir = document_root / "locales"
    required_locales = ["de-DE.json", "en-US.json", "fr-FR.json", "nl-NL.json"]
    missing = [name for name in required_locales if not (locales_dir / name).is_file()]
    # Progress page requires locales; interactive rescue.html remains usable without them.
    require_i18n = index_name == "auto-e2e-progress.html"
    i18n_ok = (not missing) if require_i18n else True
    return {
        "schema": "setuphelfer.rescue.gui-http-health.v1",
        "status": "ready",
        "payload_version": _payload_version(),
        "locale": _locale(),
        "document_root": str(document_root),
        "index_path": str(index_path),
        "index_exists": index_path.is_file(),
        "i18n_validation": "passed" if i18n_ok else "failed",
        "i18n_required": require_i18n,
        "missing_locales": missing,
        "entry_point": index_name,
    }


def _normalize_phase(phase: str) -> str:
    mapping = {
        "sabrent_waiting": "sabrent_waiting",
        "sabrent_wait": "sabrent_waiting",
        "backup_create": "backup",
        "backup_verify": "verify",
        "restore_run": "restore",
        "evidence_save": "evidence_finalize",
        "shutdown_pending": "completed",
    }
    return mapping.get(phase, phase)


def build_auto_e2e_status(state_path: Path, locale: str) -> dict[str, Any]:
    """Prefer canonical-bvr-progress.json; fall back to physical-progress then auto-e2e-state."""
    labels = PHASE_LABELS.get(locale) or PHASE_LABELS["en-US"]
    canon = _read_json(CANONICAL_PATH)
    physical = _read_json(PHYSICAL_PATH)
    state = _read_json(state_path) or {}
    source = "auto-e2e-state"
    if canon:
        source = "canonical-bvr-progress"
        phase = _normalize_phase(str(canon.get("phase") or "waiting"))
        status = str(canon.get("status") or "waiting")
        message = str(canon.get("message") or "")
        run_id = str(canon.get("run_id") or "")
        updated_at = canon.get("updated_at")
        sequence = int(canon.get("sequence") or 0)
        terminal = bool(canon.get("terminal"))
        warnings = list(canon.get("warnings") or [])
    elif physical:
        source = "physical-progress"
        phase = _normalize_phase(str(physical.get("phase") or "waiting"))
        status = str(physical.get("status") or ("passed" if phase == "shutdown" else "running"))
        message = str(physical.get("message") or "")
        run_id = str(state.get("run_id") or "")
        updated_at = physical.get("updated_at")
        sequence = int(physical.get("sequence") or 0)
        terminal = bool(physical.get("terminal")) or phase in {"shutdown", "completed"}
        warnings = []
    else:
        phase = _normalize_phase(str(state.get("phase") or "waiting"))
        status = str(state.get("status") or "waiting")
        message = str(state.get("last_progress") or "")
        run_id = str(state.get("run_id") or "")
        updated_at = state.get("updated_at")
        sequence = 0
        terminal = status in {"passed", "failed", "cancelled", "blocked"}
        warnings = []

    # Drift: canonical/physical terminal vs sticky sabrent_waiting orchestration file.
    if (canon or physical) and str(state.get("phase") or "") == "sabrent_waiting":
        if terminal or phase in {"shutdown", "completed", "backup", "verify", "restore"}:
            warnings = list(warnings) + ["rescue.bvr.progress_source_drift"]

    label = labels.get(phase, labels.get("waiting", phase))
    if message:
        label = message if locale.startswith("de") else labels.get(phase, message)
    return {
        "schema": "setuphelfer.rescue.auto-e2e-gui-status.v1",
        "active": True,
        "status": status,
        "phase": phase,
        "phase_label_de": label,
        "phase_label": label,
        "last_progress": message,
        "run_id": run_id,
        "updated_at": updated_at,
        "locale": locale,
        "payload_version": _payload_version(),
        "progress_kind": "indeterminate",
        "sequence": sequence,
        "terminal": terminal,
        "source_component": source,
        "warnings": warnings,
        "canonical": source == "canonical-bvr-progress",
    }


def write_runtime_status(payload: dict[str, Any]) -> None:
    try:
        RUNTIME_STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = RUNTIME_STATUS_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
        tmp.replace(RUNTIME_STATUS_PATH)
    except OSError:
        # Non-root unit tests / read-only /run must not crash the HTTP server.
        return


class RescueUiHandler(SimpleHTTPRequestHandler):
    document_root: Path = Path(".")
    state_path: Path = STATE_PATH
    index_name: str = "rescue.html"

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        super().__init__(*args, directory=str(self.document_root), **kwargs)

    def _send_json(self, payload: dict[str, Any], *, code: int = 200) -> None:
        body = (json.dumps(payload, ensure_ascii=True) + "\n").encode("ascii", errors="replace")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:  # noqa: N802
        path = urlparse(self.path).path
        if path in ("/health", "/health.json"):
            health = build_health(self.document_root, index_name=self.index_name)
            code = 200 if health.get("index_exists") and health.get("i18n_validation") == "passed" else 503
            if code != 200:
                health["status"] = "failed"
            self._send_json(health, code=code)
            return
        if path in ("/auto-e2e-state.json", "/api/rescue/auto-e2e-status"):
            self._send_json(build_auto_e2e_status(self.state_path, _locale()))
            return
        return super().do_GET()

    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Setuphelfer rescue GUI HTTP server")
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--document-root", default="/usr/share/setuphelfer/rescue/ui")
    parser.add_argument("--state-path", default=str(STATE_PATH))
    parser.add_argument("--index-name", default="")
    args = parser.parse_args(argv)

    root = Path(args.document_root).resolve()
    if not root.is_dir():
        print(json.dumps({"error": "rescue.gui.document_root_invalid", "path": str(root)}), file=sys.stderr)
        return 2

    index_name = args.index_name.strip()
    if not index_name:
        if (root / "auto-e2e-progress.html").is_file() and "setuphelfer_msi_e2e_auto=1" in Path(
            "/proc/cmdline"
        ).read_text(encoding="utf-8", errors="replace"):
            index_name = "auto-e2e-progress.html"
        else:
            index_name = "rescue.html"
    if not (root / index_name).is_file():
        print(json.dumps({"error": "rescue.gui.index_missing", "index": index_name}), file=sys.stderr)
        return 3

    RescueUiHandler.document_root = root
    RescueUiHandler.state_path = Path(args.state_path)
    RescueUiHandler.index_name = index_name

    try:
        server = ThreadingHTTPServer((args.bind, args.port), RescueUiHandler)
    except OSError as exc:
        print(json.dumps({"error": "rescue.gui.bind_failed", "detail": str(exc)}), file=sys.stderr)
        return 4

    write_runtime_status(
        {
            "status": "ready",
            "pid": os.getpid(),
            "runtime_user": "root",
            "bind_address": args.bind,
            "port": args.port,
            "document_root": str(root),
            "index_path": str(root / index_name),
            "health_url": f"http://{args.bind}:{args.port}/health.json",
            "health_status": "ready",
            "asset_validation": "passed",
            "i18n_validation": build_health(root, index_name=index_name).get("i18n_validation"),
            "chromium_started": False,
            "chromium_visible": False,
            "watchdog_state": "watching",
            "fallback_reason": None,
            "errors": [],
            "warnings": [],
        }
    )
    print(
        json.dumps(
            {
                "status": "listening",
                "bind": args.bind,
                "port": args.port,
                "document_root": str(root),
                "index_name": index_name,
            },
            ensure_ascii=True,
        ),
        flush=True,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        write_runtime_status({"status": "stopped", "pid": os.getpid()})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
