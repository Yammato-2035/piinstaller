#!/usr/bin/env bash
# SETUPHELFER-E2E-LIVE-001D5 — Unattended MSI physical E2E (lab auto / cmdline flag).
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=setuphelfer-rescue-common.sh
source "${SCRIPT_DIR}/setuphelfer-rescue-common.sh"

setuphelfer_rescue_ensure_state_dir

_progress_write() {
  local phase="$1"
  local msg="$2"
  local status="${3:-running}"
  local now up
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  up="$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)"
  mkdir -p "${SETUPHELFER_RESCUE_STATE_DIR}" 2>/dev/null || true
  PHASE="$phase" MSG="$msg" STATUS="$status" NOW="$now" UP="$up" \
    PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<'PY' 2>/dev/null || true
import os
from core.rescue_canonical_bvr_progress import write_canonical_progress
from core.rescue_physical_e2e_auto_e2e_state import update_auto_e2e_state, write_heartbeat

phase = os.environ.get("PHASE") or "sabrent_waiting"
msg = os.environ.get("MSG") or ""
status = os.environ.get("STATUS") or "running"
terminal = phase in {"shutdown", "completed"} or status in {"passed", "failed", "cancelled"}
write_canonical_progress(
    phase=phase,
    status="passed" if phase == "shutdown" and status == "running" else status,
    message=msg,
    source_component="auto-physical-e2e",
    terminal=terminal,
)
# Compatibility: keep auto-e2e-state in sync but it is not authoritative for display.
update_auto_e2e_state(
    phase=phase if phase in {
        "msi_hardware_check", "msi_evidence_waiting", "msi_evidence_running", "msi_evidence_complete",
        "sabrent_waiting", "sabrent_detected", "sabrent_identity_verified", "disk_partitioning",
        "disk_formatting", "test_data_create", "backup_create", "backup_verify", "restore_run",
        "data_compare", "telemetry_send", "diagnostics_fetch", "evidence_save", "shutdown_pending",
        "shutdown",
    } else "sabrent_waiting",
    status=("passed" if terminal and status != "failed" else status),
    last_progress=msg,
)
write_heartbeat(run_id="auto-physical-e2e", phase=phase)
PY
}

if ! setuphelfer_rescue_msi_e2e_auto_active; then
  exit 0
fi

_progress_write "sabrent_waiting" "Physical-E2E gestartet — Initialisierung…"
setuphelfer_rescue_write_boot_state "auto_physical_e2e_running" || true

# 001D7B: run-mode lock (also enforced via ExecCondition start-gate).
_skip_mode="$(PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<'PY' 2>/dev/null || echo allow
from core.rescue_physical_e2e_start_gate import evaluate_physical_e2e_start_gate
r = evaluate_physical_e2e_start_gate()
print("skip" if not r.get("physical_e2e_start_allowed") else "allow")
PY
)"
if [[ "$_skip_mode" == "skip" ]]; then
  touch "${SETUPHELFER_RESCUE_STATE_DIR}/auto-physical-e2e.done" 2>/dev/null || true
  setuphelfer_rescue_write_boot_state "auto_physical_e2e_skipped_by_run_mode" || true
  _progress_write "shutdown" "Physical-E2E übersprungen (Run-Mode)"
  exit 0
fi

_marker="${SETUPHELFER_RESCUE_STATE_DIR}/auto-physical-e2e.done"
if [[ -f "$_marker" ]]; then
  exit 0
fi

_log="${SETUPHELFER_RESCUE_STATE_DIR}/auto-physical-e2e.log"
{
  echo "=== auto-physical-e2e $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  echo "cmdline=$(tr '\0' ' ' </proc/cmdline 2>/dev/null || true)"
} >>"$_log"

_resolve_setup_logs() {
  # Prefer the writable esp-rw mount that actually holds setuphelfer/.
  if [[ -d /run/setuphelfer/esp-rw/setuphelfer ]]; then
    echo /run/setuphelfer/esp-rw
    return 0
  fi
  PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<'PY' 2>/dev/null || true
from pathlib import Path
from core.rescue_physical_e2e_evidence_import import find_setup_logs_mount

logs = find_setup_logs_mount()
if logs is not None and (logs / "setuphelfer").is_dir():
    print(logs)
    raise SystemExit(0)
for candidate in (
    Path("/run/setuphelfer/esp-rw"),
    Path("/run/setuphelfer-rescue/media/SETUP_LOGS"),
):
    if (candidate / "setuphelfer").is_dir():
        print(candidate)
        raise SystemExit(0)
raise SystemExit(1)
PY
}

_logs_mount="$(_resolve_setup_logs || true)"
_wait_i=0
_wait_max=90
echo "Waiting for SETUP_LOGS with setuphelfer/ (max ${_wait_max}s)…" >>"$_log"
while [[ "$_wait_i" -lt "$_wait_max" ]]; do
  if [[ -n "$_logs_mount" && -d "$_logs_mount/setuphelfer" ]]; then
    echo "SETUP_LOGS ready: ${_logs_mount}" >>"$_log"
    break
  fi
  _progress_write "sabrent_waiting" "Warte auf SETUP_LOGS… (${_wait_i}/${_wait_max}s)"
  _logs_mount="$(_resolve_setup_logs || true)"
  _wait_i=$((_wait_i + 5))
  sleep 5
done

if [[ -z "$_logs_mount" || ! -d "$_logs_mount/setuphelfer" ]]; then
  echo "ERROR: SETUP_LOGS mount missing — physical E2E blocked" >>"$_log"
  setuphelfer_rescue_write_boot_state "auto_physical_e2e_blocked_setup_logs"
  _progress_write "shutdown" "SETUP_LOGS fehlt — Physical-E2E blockiert"
  # Still try to leave the log somewhere visible via spool.
  setuphelfer_rescue_mirror_evidence_file "$_log" "setuphelfer/evidence/e2e/auto-physical-e2e.log" 2>/dev/null || true
  exit 0
fi

mkdir -p "${_logs_mount}/setuphelfer/evidence/e2e" 2>/dev/null || true
cp -f "$_log" "${_logs_mount}/setuphelfer/evidence/e2e/auto-physical-e2e.log" 2>/dev/null || true
cp -f "${SETUPHELFER_RESCUE_STATE_DIR}/physical-progress.json" \
  "${_logs_mount}/setuphelfer/evidence/e2e/physical-progress.json" 2>/dev/null || true

_progress_write "sabrent_waiting" "Suche SABRENT-Festplatte…"

_ev_base="$(setuphelfer_rescue_evidence_writable_base 2>/dev/null || echo "${_logs_mount}")"
_e2e_ok=0
# Heartbeat watchdog while Python runs (wipe can take many minutes).
(
  while true; do
    sleep 10
    if [[ -f "${SETUPHELFER_RESCUE_STATE_DIR}/auto-physical-e2e.done" ]]; then
      exit 0
    fi
    if ! kill -0 $$ 2>/dev/null; then
      exit 0
    fi
    phase="disk_partitioning"
    if [[ -f "${SETUPHELFER_RESCUE_STATE_DIR}/physical-progress.json" ]]; then
      phase="$(python3 -c "import json;print(json.load(open('${SETUPHELFER_RESCUE_STATE_DIR}/physical-progress.json')).get('phase') or 'disk_partitioning')" 2>/dev/null || echo disk_partitioning)"
    fi
    PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<PY 2>/dev/null || true
from core.rescue_physical_e2e_auto_e2e_state import write_heartbeat
write_heartbeat(run_id="auto-physical-e2e", phase="${phase}")
PY
  done
) &
_hb_pid=$!

_progress_write "sabrent_waiting" "Starte Backup/Verify/Restore auf SABRENT…"
if setuphelfer_rescue_run_msi_physical_e2e_auto "$_ev_base" >>"$_log" 2>&1; then
  _e2e_ok=1
  echo "E2E auto: passed" >>"$_log"
else
  echo "WARN: auto physical E2E failed" >>"$_log"
fi

kill "${_hb_pid}" 2>/dev/null || true
wait "${_hb_pid}" 2>/dev/null || true

_result="${_ev_base}/setuphelfer/evidence/e2e/msi-e2e-auto-result.json"
if [[ -f "$_result" ]]; then
  setuphelfer_rescue_mirror_evidence_file "$_result" "setuphelfer/evidence/e2e/msi-e2e-auto-result.json" 2>/dev/null || true
fi
cp -f "$_log" "${_logs_mount}/setuphelfer/evidence/e2e/auto-physical-e2e.log" 2>/dev/null || true

if [[ "$_e2e_ok" -eq 1 ]]; then
  touch "$_marker" 2>/dev/null || true
  setuphelfer_rescue_write_boot_state "auto_physical_e2e_passed"
  _progress_write "shutdown" "Physical-E2E erfolgreich" "passed"
else
  setuphelfer_rescue_write_boot_state "auto_physical_e2e_failed"
  _progress_write "shutdown" "Physical-E2E fehlgeschlagen — siehe auto-physical-e2e.log" "failed"
fi

# Final mirror of orchestration state (non-authoritative) onto SETUP_LOGS.
PYTHONPATH="$(setuphelfer_rescue_backend_pythonpath)" python3 - <<PY 2>/dev/null || true
from pathlib import Path
from core.rescue_physical_e2e_auto_e2e_state import mirror_state_to_setup_logs, read_auto_e2e_state
from core.rescue_canonical_bvr_progress import detect_progress_source_drift, read_canonical_progress
logs = Path("${_logs_mount}")
mirror_state_to_setup_logs(logs)
drift = detect_progress_source_drift(
    canonical=read_canonical_progress(),
    auto_e2e_state=read_auto_e2e_state(),
)
out = logs / "setuphelfer/evidence/e2e/progress-source-drift.json"
out.parent.mkdir(parents=True, exist_ok=True)
import json
out.write_text(json.dumps(drift, indent=2) + "\n", encoding="utf-8")
PY

sync 2>/dev/null || true
if setuphelfer_rescue_auto_shutdown_requested; then
  setuphelfer_rescue_auto_shutdown_if_requested "physical_e2e_complete" || true
fi
exit 0
